# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Your Supabase Public Anon Key
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Optional Supabase Service Role Key for backend administration
SUPABASE_SERVICE_ROLE_KEY=

# APP_PASSWORD: Set this on any internet-facing deployment. Browsers will prompt for it
# (HTTP Basic; the username can be anything). Leave empty for local use.
APP_PASSWORD=

# ENABLE_DIAGNOSTICS: set to "true" to allow the hidden adaptive-engine simulation in production.
ENABLE_DIAGNOSTICS=
