+    <div className={`relative ${className}`}>
+      <Search aria-hidden className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-ink-4" />
+      <input type="search" className={`${inputBase} pl-9`} {...p} />
